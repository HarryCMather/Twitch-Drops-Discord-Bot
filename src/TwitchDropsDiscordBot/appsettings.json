{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "NLog": {
    "LogDirectory": "../Logs"
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ExporterEndpoint": "http://otelexporterendpoint:4317"
  },
  "ConnectionStrings": {
    "Postgresql": "Host=SetYourHostHere;Port=5432;Database=twitch_drops_bot;Username=twitch_drops_bot;Password=SetYourPasswordHere;Timeout=15;Pooling=True;Minimum Pool Size=1;Maximum Pool Size=10;"
  },
  "Discord": {
    "BotToken": "SET DISCORD TOKEN HERE",
    "TargetChannelId": 1234567890
  },
  "Bot": {
    "DelayBetweenChecksInMinutes": 15
  }
}
